<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="agricola_view_catalogos_fincas_list" model="ir.ui.view">
            <field name="name">agricola.catalogos.fincas.list</field>
            <field name="model">agricola.catalogos.fincas</field>
            <field name="arch" type="xml">
                <list string="Fincas">
                    <field name="name"/>
                    <field name="descripcion"/>
                    <field name="partner_id"/>
                </list>
            </field>
        </record>

        <record id="agricola_view_catalogos_fincas_form" model="ir.ui.view">
            <field name="name">agricola.catalogos.fincas.form</field>
            <field name="model">agricola.catalogos.fincas</field>
            <field name="arch" type="xml">
                <form string="Fincas">
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                    <group>
                        <field name="areas">
                            <form string="Areas">
                                <field name="name" required="1"/>
                                <field name="descripcion"/>
                            </form>
                            <list editable="bottom" string="Areas">
                                <field name="name" required="1"/>
                                <field name="descripcion"/>
                            </list>
                        </field>
                    </group>
                </form>
            </field>
        </record>

        <record id="agricola_action_catalogos_fincas_form" model="ir.actions.act_window">
            <field name="name">Fincas</field>
            <field name="res_model">agricola.catalogos.fincas</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="agricola_view_catalogos_areas_list" model="ir.ui.view">
            <field name="name">agricola.catalogos.areas.list</field>
            <field name="model">agricola.catalogos.areas</field>
            <field name="arch" type="xml">
                <list string="Areas">
                    <field name="name"/>
                    <field name="descripcion"/>
                    <field name="finca_id"/>
                </list>
            </field>
        </record>

        <record id="agricola_view_catalogos_areas_form" model="ir.ui.view">
            <field name="name">agricola.catalogos.areas.form</field>
            <field name="model">agricola.catalogos.areas</field>
            <field name="arch" type="xml">
                <form string="Areas">
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="finca_id" required="1"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                    <group>
                        <field name="subareas">
                            <form string="Sub Areas">
                                <field name="name" required="1"/>
                                <field name="descripcion"/>
                            </form>
                            <list editable="bottom" string="Sub Areas">
                                <field name="name" required="1"/>
                                <field name="descripcion"/>
                            </list>
                        </field>
                    </group>
                </form>
            </field>
        </record>

        <record id="agricola_action_catalogos_areas_form" model="ir.actions.act_window">
            <field name="name">Areas</field>
            <field name="res_model">agricola.catalogos.areas</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="agricola_view_catalogos_subareas_list" model="ir.ui.view">
            <field name="name">agricola.catalogos.subareas.list</field>
            <field name="model">agricola.catalogos.subareas</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="descripcion"/>
                    <field name="area_id"/>
                </list>
            </field>
        </record>

        <record id="agricola_view_catalogos_subareas_form" model="ir.ui.view">
            <field name="name">agricola.catalogos.subareas.form</field>
            <field name="model">agricola.catalogos.subareas</field>
            <field name="arch" type="xml">
                <form string="Sub Areas">
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="area_id" required="1"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="agricola_action_catalogos_subareas_form" model="ir.actions.act_window">
            <field name="name">Sub Areas</field>
            <field name="res_model">agricola.catalogos.subareas</field>
            <field name="view_mode">list,form</field>
        </record>

        
        <record id="agricola_view_catalogos_duracion_tarea_list" model="ir.ui.view">
            <field name="name">agricola.catalogos.duracion_tarea.list</field>
            <field name="model">agricola.catalogos.duracion_tarea</field>
            <field name="arch" type="xml">
                <list string="Duración de la tarea">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="agricola_view_catalogos_duracion_tarea_form" model="ir.ui.view">
            <field name="name">agricola.catalogos.duracion_tarea.form</field>
            <field name="model">agricola.catalogos.duracion_tarea</field>
            <field name="arch" type="xml">
                <form string="Duración de la tarea">
                    <group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="agricola_action_catalogos_duracion_tarea_form" model="ir.actions.act_window">
            <field name="name">Duración de la tarea</field>
            <field name="res_model">agricola.catalogos.duracion_tarea</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Agricola" id="menu_agricola_root" groups="base.group_user"/>
        <menuitem name="Catalogos" id="menu_agricola_catalogos" parent="menu_agricola_root" groups="base.group_user"/>
        <menuitem name="Fincas" id="menu_agricola_catalogos_fincas_action" parent="menu_agricola_catalogos" action="agricola_action_catalogos_fincas_form" groups="base.group_user"/>
        <menuitem name="Areas" id="menu_agricola_catalogos_areas_action" parent="menu_agricola_catalogos" action="agricola_action_catalogos_areas_form" groups="base.group_user"/>
        <menuitem name="Sub Areas" id="menu_agricola_catalogos_subareas_action" parent="menu_agricola_catalogos" action="agricola_action_catalogos_subareas_form" groups="base.group_user"/>
        <menuitem name="Duración tareas" id="menu_agricola_catalogos_duracion_tarea_action" parent="menu_agricola_catalogos" action="agricola_action_catalogos_duracion_tarea_form" groups="base.group_user"/>

    </data>
</odoo>
