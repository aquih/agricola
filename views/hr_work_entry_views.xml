<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="agricola_hr_work_entry_view_form" model="ir.ui.view">
            <field name="name">agricola.hr.work.entry.form</field>
            <field name="model">hr.work.entry</field>
            <field name="inherit_id" ref="hr_work_entry.hr_work_entry_view_form"/>
            <field name="arch" type="xml">
                <field name="work_entry_type_id" position="after">
                    <field name="subarea_id"/>
                    <field name="area_id"/>
                    <field name="finca_id"/>
                </field>
                <field name="company_id" position="before">
                    <field name="produccion"/>
                    <field name="udm_produccion"/>
                </field>
            </field>
        </record>

        <record id="agricola_hr_work_entry_view_tree" model="ir.ui.view">
            <field name="name">agricola.hr.work.entry.list</field>
            <field name="model">hr.work.entry</field>
            <field name="inherit_id" ref="hr_work_entry.hr_work_entry_view_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="employee_id"/>
                </field>
                <field name="work_entry_type_id" position="after">
                    <field name="subarea_id"/>
                    <field name="area_id"/>
                    <field name="finca_id"/>
                </field>
                <field name="date_stop" position="after">
                    <field name="produccion"/>
                    <field name="udm_produccion"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
